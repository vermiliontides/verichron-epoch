{
  "name": "@verichron/mvt-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "mvt-runner": "./dist/main.js"
  },
  "scripts": {
    "build:contracts": "pnpm --filter @verichron/contracts build",
    "prebuild": "pnpm run build:contracts",
    "build": "tsc",
    "prestart": "pnpm run build:contracts",
    "start": "node dist/main.js",
    "predev": "pnpm run build:contracts",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@verichron/contracts": "workspace:*",
    "@verichron/db-reader": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}