From 257382f51d9b868e592473b5eedc323cb39e0762 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Thu, 27 Aug 2026 18:46:02 +0000
Subject: [PATCH] Fix pnpm build script; give packages/db a real package.json

- Root package.json had no "build" script, only "build:contracts". pnpm
  build fell through to spawning a literal binary named "build" off
  PATH (ENOENT). Added "build": "pnpm -r --if-present run build" so it
  runs build across every workspace package that defines one, and skips
  ones that don't rather than failing on them.

- packages/db had no package.json at all, so pnpm's workspace glob
  matched the directory but never registered it as a package -- nothing
  could depend on it, and it built nothing. Added package.json (name
  @verichron/db-writer, per the name packages/contracts/index.ts already
  referenced), tsconfig.json (mirrors packages/contracts's), and index.ts
  re-exporting dbWriter.ts's public surface: DEFAULT_DB_URL,
  computeFileHash, IngestUnit, ingest, writeRecord, writeRecords,
  incompleteIngests, MAX_RECORDS_PER_STATEMENT, plus the IngestParams/
  IngestOutcome types. pg is a peerDependency, not a dependency: every
  function in dbWriter.ts takes a caller-supplied Client/PoolClient
  rather than instantiating one itself, so this package should track the
  caller's pg version rather than bundling its own.

- Fixed a stale packages-py path in dbWriter.ts's own header comment
  (referenced packages-py/extractors/db_writer.py; the file lives at
  packages/db/db_writer.py).

Not wired in: apps/orchestrator continues to write pipeline_runs /
pipeline_stage_status directly via parameterized pg queries, which is
the correct boundary for that table pair -- simple upserts, no
cross-file dedup, no partial-write hazard, nothing @verichron/db-writer's
ingest() is solving. @verichron/db-writer targets ingested_files /
forensic_records, and specifically a future TypeScript extractor writing
to them; none exists today (crash, ileapp_bridge, and mvt_iocs are all
Python and use db_writer.py). apps/mvt-runner writes to Postgres nowhere
in its source -- it is a filesystem-only tool by its own header comment
("a personal-analysis tool, not a chain-of-custody / forensic evidence
tool") -- so there was nothing there to route through this package.

Every symbol re-exported in index.ts was checked by name against a real
export in dbWriter.ts.
---
 package.json              |  1 +
 packages/db/dbWriter.ts   |  2 +-
 packages/db/index.ts      | 29 +++++++++++++++++++++++++++++
 packages/db/package.json  | 30 ++++++++++++++++++++++++++++++
 packages/db/tsconfig.json | 10 ++++++++++
 5 files changed, 71 insertions(+), 1 deletion(-)
 create mode 100644 packages/db/index.ts
 create mode 100644 packages/db/package.json
 create mode 100644 packages/db/tsconfig.json

diff --git a/package.json b/package.json
index 1a6daab..767c9b0 100644
--- a/package.json
+++ b/package.json
@@ -4,6 +4,7 @@
   "private": true,
   "description": "Privacy-first local desktop forensic client and incident response orchestration engine",
   "scripts": {
+    "build": "pnpm -r --if-present run build",
     "build:contracts": "pnpm --filter @verichron/contracts build",
     "sync:contracts": "python3 scripts/sync_contracts.py --write",
     "check:contracts": "python3 scripts/sync_contracts.py --check"
diff --git a/packages/db/dbWriter.ts b/packages/db/dbWriter.ts
index e1b4cac..779653d 100644
--- a/packages/db/dbWriter.ts
+++ b/packages/db/dbWriter.ts
@@ -1,6 +1,6 @@
 /**
  * Postgres write helpers for TypeScript callers — the mirror of
- * packages-py/extractors/db_writer.py, and deliberately semantically identical
+ * packages/db/db_writer.py, and deliberately semantically identical
  * to it rather than merely similar.
  *
  * Why `ingest()` takes a callback instead of exposing `ingestFile()`
diff --git a/packages/db/index.ts b/packages/db/index.ts
new file mode 100644
index 0000000..d075f09
--- /dev/null
+++ b/packages/db/index.ts
@@ -0,0 +1,29 @@
+/**
+ * Public entry point for `@verichron/db-writer`.
+ *
+ * Not currently imported anywhere in this repo: apps/orchestrator writes
+ * pipeline_runs/pipeline_stage_status directly with parameterized `pg`
+ * queries, which is the correct boundary for that table pair (simple
+ * upserts, no cross-file dedup, no partial-write hazard). This package
+ * exists for ingested_files/forensic_records, and specifically for a
+ * TypeScript extractor that writes to them -- none exists yet; all three
+ * current extractors (crash, ileapp_bridge, mvt_iocs) are Python and use
+ * db_writer.py. When a TypeScript extractor is added, it should depend on
+ * this package rather than issuing its own forensic_records inserts, for
+ * the same reason db_writer.py is mandatory on the Python side: the
+ * ingest/dedup atomicity guarantee documented on `ingest()` below is easy
+ * to defeat by accident and hard to notice you've defeated, and this
+ * package is the one place that guarantee is implemented and tested.
+ */
+
+export {
+  DEFAULT_DB_URL,
+  computeFileHash,
+  IngestUnit,
+  ingest,
+  writeRecord,
+  writeRecords,
+  incompleteIngests,
+  MAX_RECORDS_PER_STATEMENT,
+} from "./dbWriter.js";
+export type { IngestParams, IngestOutcome } from "./dbWriter.js";
diff --git a/packages/db/package.json b/packages/db/package.json
new file mode 100644
index 0000000..08aef5a
--- /dev/null
+++ b/packages/db/package.json
@@ -0,0 +1,30 @@
+{
+  "name": "@verichron/db-writer",
+  "version": "0.1.0",
+  "private": true,
+  "description": "Schema-bound, transaction-safe Postgres write helpers (atomic ingest) for ingested_files/forensic_records -- the TypeScript mirror of verichron-db (db_writer.py). Not used by apps/orchestrator, which owns pipeline_runs/pipeline_stage_status directly; this package exists for a future TypeScript extractor writing forensic_records.",
+  "main": "./dist/index.js",
+  "types": "./dist/index.d.ts",
+  "exports": {
+    ".": {
+      "types": "./dist/index.d.ts",
+      "default": "./dist/index.js"
+    }
+  },
+  "scripts": {
+    "build": "tsc",
+    "typecheck": "tsc --noEmit"
+  },
+  "dependencies": {
+    "@verichron/contracts": "workspace:*"
+  },
+  "peerDependencies": {
+    "pg": "^8.11.0"
+  },
+  "devDependencies": {
+    "@types/node": "^20.11.0",
+    "@types/pg": "^8.11.0",
+    "pg": "^8.11.0",
+    "typescript": "^5.4.0"
+  }
+}
diff --git a/packages/db/tsconfig.json b/packages/db/tsconfig.json
new file mode 100644
index 0000000..4bbe723
--- /dev/null
+++ b/packages/db/tsconfig.json
@@ -0,0 +1,10 @@
+{
+  "extends": "../../tsconfig.json",
+  "compilerOptions": {
+    "outDir": "./dist",
+    "rootDir": "."
+  },
+  "include": [
+    "./*.ts"
+  ]
+}
