  "version": "0.1.0",
  "description": "Forensic pipeline visualization for verichron",
  "main": ".vite/build/main.js",
  "preload": ".vite/build/preload.js",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean:ts": "find src/ -type f \\( -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' \\) ! -name 'env.d.ts' -delete",
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint ."
  },
  "keywords": [],
