  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@verichron/*": [
        "../../libs/*",
        "../../packages/*"
      ]
    }
  },
  "include": ["./src/**/*.ts"]
}